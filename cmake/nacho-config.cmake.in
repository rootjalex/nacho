cmake_minimum_required(VERSION 3.30)
@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/nacho-targets.cmake")

get_target_property(_nacho_configs nacho::compiler IMPORTED_CONFIGURATIONS)
if (RELEASE IN_LIST _nacho_configs)
    get_target_property(_nacho_exe nacho::compiler IMPORTED_LOCATION_RELEASE)
elseif (_nacho_configs)
    list(GET _nacho_configs 0 _nacho_config)
    get_target_property(_nacho_exe nacho::compiler "IMPORTED_LOCATION_${_nacho_config}")
else ()
    set(_nacho_exe "-NOTFOUND")
endif ()

set_and_check(nacho_EXECUTABLE "${_nacho_exe}")

check_required_components(nacho)
